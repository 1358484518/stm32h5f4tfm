# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf
# SPE NSC veneers: NS CubeIDE / makefile projects must link the exported object.
!tfmmakeproject/api_ns/interface/lib/s_veneers.o
!tfmcubeideproject/STM32CubeIDE/spe/api_ns/interface/lib/s_veneers.o
# MCUboot imgtool pad sizes (S 512 KB / NS 1 MB). Fresh clones need these to sign.
!tfmmakeproject/api_ns/image_signing/layout_files/signing_layout_s.o
!tfmmakeproject/api_ns/image_signing/layout_files/signing_layout_ns.o
!tfmcubeideproject/STM32CubeIDE/spe/api_ns/image_signing/layout_files/signing_layout_s.o
!tfmcubeideproject/STM32CubeIDE/spe/api_ns/image_signing/layout_files/signing_layout_ns.o
!tfmcubeideproject/STM32CubeIDE/sign_kit/layout/signing_layout_s.o
!tfmcubeideproject/STM32CubeIDE/sign_kit/layout/signing_layout_ns.o

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# Local Python venv (recreated by ./buildtfm.sh)
.venv/

# FetchContent dependency cache (kept across clean builds; see scripts/clean_tfm_build.sh)
trusted-firmware-m/.deps-cache/
